import os
import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns

# Set chart style
sns.set_theme(style="whitegrid")
plt.rcParams["figure.figsize"] = (10, 6)


def analyze_personal_finance(file_path):

    print("🚀 Loading and cleaning data...")

    # 1. Check file exists
    if not os.path.exists(file_path):
        print(f"❌ Error: File '{file_path}' not found.")
        return

    # 2. Load dataset
    try:
        df = pd.read_csv(file_path)
    except Exception as e:
        print(f"❌ Error reading CSV file: {e}")
        return

    # 3. Validate required columns
    required_columns = ["Date", "Category", "Type", "Amount"]

    for col in required_columns:
        if col not in df.columns:
            print(f"❌ Missing required column: {col}")
            return

    # 4. Data Cleaning
    try:
        df["Date"] = pd.to_datetime(df["Date"])
    except Exception:
        print("❌ Invalid date format in 'Date' column.")
        return

    df["Category"] = df["Category"].astype(str).str.strip()
    df["Type"] = df["Type"].astype(str).str.strip()
    df["Amount"] = pd.to_numeric(df["Amount"], errors="coerce")

    # Remove invalid amount rows
    df = df.dropna(subset=["Amount"])

    # Create month column
    df["Year_Month"] = df["Date"].dt.to_period("M")

    # 5. Separate income and expenses
    expenses = df[df["Type"].str.lower() == "expense"].copy()
    income = df[df["Type"].str.lower() == "income"].copy()

    # 6. Financial Summary
    total_income = income["Amount"].sum()
    total_expense = expenses["Amount"].sum()
    net_savings = total_income - total_expense

    savings_rate = (
        (net_savings / total_income) * 100
        if total_income > 0 else 0
    )

    print("\n" + "=" * 45)
    print("        FINANCIAL SUMMARY REPORT")
    print("=" * 45)

    print(f"💰 Total Income     : ${total_income:,.2f}")
    print(f"💸 Total Expenses   : ${total_expense:,.2f}")
    print(f"🏦 Net Savings      : ${net_savings:,.2f}")
    print(f"📈 Savings Rate     : {savings_rate:.2f}%")

    print("=" * 45)

    # 7. Expense Category Analysis
    print("\n📊 Expense Analysis by Category")

    cat_summary = (
        expenses.groupby("Category")["Amount"]
        .agg(["sum", "count", "mean"])
        .sort_values(by="sum", ascending=False)
    )

    cat_summary.columns = [
        "Total Spent",
        "Transactions",
        "Average Expense"
    ]

    print(cat_summary)

    # 8. Bar Chart - Expenses by Category
    plt.figure()

    sns.barplot(
        x=cat_summary["Total Spent"],
        y=cat_summary.index,
        hue=cat_summary.index,
        palette="viridis",
        legend=False
    )

    plt.title("Total Expenses by Category",
              fontsize=14,
              fontweight="bold")

    plt.xlabel("Amount Spent ($)")
    plt.ylabel("Category")

    plt.tight_layout()

    plt.savefig("expenses_by_category.png")

    print("✅ Saved: expenses_by_category.png")

    # 9. Monthly Income vs Expense Trend
    print("\n📈 Monthly Trend Analysis")

    monthly_summary = (
        df.groupby(["Year_Month", "Type"])["Amount"]
        .sum()
        .unstack(fill_value=0)
    )

    # Convert PeriodIndex to string
    monthly_summary.index = monthly_summary.index.astype(str)

    plt.figure()

    monthly_summary.plot(
        kind="line",
        marker="o",
        linewidth=2
    )

    plt.title("Monthly Income vs Expense Trend",
              fontsize=14,
              fontweight="bold")

    plt.xlabel("Month")
    plt.ylabel("Amount ($)")

    plt.grid(True, linestyle="--", alpha=0.7)

    plt.tight_layout()

    plt.savefig("income_vs_expense_trend.png")

    print("✅ Saved: income_vs_expense_trend.png")

    print("\n🎉 Analysis Completed Successfully!")


# Run the project
analyze_personal_finance("Personal_Finance_Dataset.csv")
